<Entity tags="teleportable_NOT,item_pickup,witch_sheet">
	<!-- A sheet with one of the wiki's seals ready drawn. sheets.lua (sheet_spawn) gives it its seal, name, picture and
	     a slow hover; picked up with the interact button, it is pasted into the spellbook (sheet_pickup.lua). -->

	<HitboxComponent
		_tags="enabled_in_world"
		aabb_min_x="-7"
		aabb_max_x="7"
		aabb_min_y="-9"
		aabb_max_y="8"
		is_enemy="0"
		is_item="1"
		is_player="0"
	></HitboxComponent>

	<LightComponent
		_tags="enabled_in_world"
		_enabled="1"
		r="255"
		g="226"
		b="170"
		radius="40"
		fade_out_time="0.75"
	></LightComponent>

	<!-- a few motes of light rise off the paper -->
	<SpriteParticleEmitterComponent
		sprite_file="mods/witch_notebook/files/gfx/mote.png"
		delay="0"
		lifetime="1.2"
		color.r="1" color.g="0.9" color.b="0.6" color.a="0.8"
		color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-0.7"
		velocity.x="0" velocity.y="-6"
		gravity.x="0" gravity.y="0"
		velocity_slowdown="0"
		rotation="0"
		angular_velocity="0"
		use_velocity_as_rotation="0"
		scale.x="1" scale.y="1"
		scale_velocity.x="0" scale_velocity.y="0"
		emission_interval_min_frames="18"
		emission_interval_max_frames="40"
		count_min="1"
		count_max="1"
		randomize_position.min_x="-6"
		randomize_position.max_x="6"
		randomize_position.min_y="-7"
		randomize_position.max_y="6"
		randomize_velocity.min_x="-2"
		randomize_velocity.max_x="2"
		randomize_velocity.min_y="-3"
		randomize_velocity.max_y="0"
		render_back="0"
		z_index="-1"
		additive="1"
		emissive="1"
		_tags="enabled_in_world"
	></SpriteParticleEmitterComponent>

	<LuaComponent
		script_item_picked_up="mods/witch_notebook/files/sheet_pickup.lua"
	></LuaComponent>
</Entity>
