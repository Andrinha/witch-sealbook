<!-- Template of a seal field (Dispersion held still: the "circle of" an element), made around the caster: sparks mark its
     circle, its element's matter rises on the circle and whoever is inside takes the element's touch (behaviors/field.lua),
     enemies inside take the element's damage. The circle stays as big as the field: the game's own circle spells grow
     their ring out to 256 pixels, which looked like a wave. init.lua fills the double-brace fields and creates
     carriers/field_<element>.xml (see bolt.xml). -->
<Entity name="$projectile_default" tags="projectile_player,witch_seal_projectile">
	<VariableStorageComponent name="witch_field_material" value_string="{{material}}" ></VariableStorageComponent>
	<VariableStorageComponent name="witch_field_status" value_string="{{status}}" ></VariableStorageComponent>
	<VariableStorageComponent name="witch_field_glow" value_string="{{glow}}" ></VariableStorageComponent>

	<ParticleEmitterComponent
		emitted_material_name="{{spark}}"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		lifetime_min="0.3"
		lifetime_max="0.8"
		count_min="2"
		count_max="4"
		area_circle_radius.min="{{field_radius}}"
		area_circle_radius.max="{{field_radius}}"
		x_vel_min="-5"
		x_vel_max="5"
		y_vel_min="-5"
		y_vel_max="5"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		is_emitting="1"
	></ParticleEmitterComponent>

	<!-- only enemies: the caster stands in the middle -->
	<AreaDamageComponent
		circle_radius="{{field_radius}}"
		aabb_min.x="-{{field_radius}}"
		aabb_min.y="-{{field_radius}}"
		aabb_max.x="{{field_radius}}"
		aabb_max.y="{{field_radius}}"
		damage_per_frame="{{field_damage}}"
		update_every_n_frame="{{field_every}}"
		entities_with_tag="enemy"
		death_cause="Seal"
		damage_type="{{field_damage_type}}"
	></AreaDamageComponent>

	<LightComponent
		_enabled="1"
		radius="{{light_radius}}"
		r="{{r}}"
		g="{{g}}"
		b="{{b}}"
	></LightComponent>

	<LifetimeComponent
		lifetime="{{field_lifetime}}"
	></LifetimeComponent>

	<LuaComponent
		script_source_file="mods/witch_notebook/files/behaviors/field.lua"
		execute_every_n_frame="{{field_interval}}"
	></LuaComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/circle_of"
	></AudioComponent>
</Entity>
