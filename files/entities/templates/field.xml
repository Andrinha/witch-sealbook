<!-- Template of a seal field (burst: a seal without signs), made around the caster: the element's
     material spreads in a ring, sparks mark it and enemies inside take the element's damage. init.lua
     fills the double-brace fields and creates carriers/field_<element>.xml (see bolt.xml). -->
<Entity name="$projectile_default" tags="projectile_player,witch_seal_projectile">
	<ParticleEmitterComponent
		emitted_material_name="{{material}}"
		create_real_particles="1"
		gravity.y="0.0"
		lifetime_min="8"
		lifetime_max="15"
		count_min="1"
		count_max="1"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="0"
		area_circle_radius.max="0"
		cosmetic_force_create="0"
		airflow_force="0.251"
		airflow_time="1.01"
		airflow_scale="0.05"
		emission_interval_min_frames="{{field_interval}}"
		emission_interval_max_frames="{{field_interval}}"
		emit_cosmetic_particles="0"
		image_animation_file="data/particles/image_emitters/circle_256.png"
		image_animation_speed="1"
		image_animation_loop="0"
		image_animation_raytrace_from_center="1"
		collide_with_gas_and_fire="0"
		set_magic_creation="1"
		is_emitting="{{trail}}"
	></ParticleEmitterComponent>

	<ParticleEmitterComponent
		emitted_material_name="{{spark}}"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		lifetime_min="0.3"
		lifetime_max="0.8"
		count_min="2"
		count_max="4"
		area_circle_radius.min="{{field_radius}}"
		area_circle_radius.max="{{field_radius}}"
		x_vel_min="-5"
		x_vel_max="5"
		y_vel_min="-5"
		y_vel_max="5"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		is_emitting="1"
	></ParticleEmitterComponent>

	<!-- only enemies: the caster stands in the middle -->
	<AreaDamageComponent
		circle_radius="{{field_radius}}"
		aabb_min.x="-{{field_radius}}"
		aabb_min.y="-{{field_radius}}"
		aabb_max.x="{{field_radius}}"
		aabb_max.y="{{field_radius}}"
		damage_per_frame="{{field_damage}}"
		update_every_n_frame="{{field_every}}"
		entities_with_tag="enemy"
		death_cause="Seal"
		damage_type="{{field_damage_type}}"
	></AreaDamageComponent>

	<LightComponent
		_enabled="1"
		radius="{{light_radius}}"
		r="{{r}}"
		g="{{g}}"
		b="{{b}}"
	></LightComponent>

	<LifetimeComponent
		lifetime="{{field_lifetime}}"
	></LifetimeComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/circle_of"
	></AudioComponent>
</Entity>
