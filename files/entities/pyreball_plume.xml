	     cells directly would ignore those settings and let the material drain down. -->
	<ParticleEmitterComponent
		emitted_material_name="fire"
		custom_style="FIRE"
		create_real_particles="0"
		emit_real_particles="1"
		emit_cosmetic_particles="0"
		emit_only_if_there_is_space="1"
		cosmetic_force_create="0"
		collide_with_grid="1"
		gravity.x="0"
		gravity.y="-25"
		area_circle_radius.min="0"
		area_circle_radius.max="4.5"
		x_pos_offset_min="0"
		x_pos_offset_max="0"
		y_pos_offset_min="0"
		y_pos_offset_max="0"
		x_vel_min="-6"
		x_vel_max="6"
		y_vel_min="-35"
		y_vel_max="-18"
		count_min="3"
		count_max="5"
		lifetime_min="0.35"
		lifetime_max="0.65"
		airflow_force="0.3"
		airflow_time="0.8"
		airflow_scale="0.07"
		friction="0.05"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="0"
	/>
</Entity>
