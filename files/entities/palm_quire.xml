<Entity tags="witch_spellbook,item_pickup,item_physics,teleportable_NOT">
	<!-- The Palm Quire (books.lua): a round notepad strapped to the hand, as witches carry in Witch Hat Atelier -
	     small seals only, cast quickly. Sold now and then in the Holy Mountains. RMB in hand or the configured key opens it (notebook.lua), a left click
	     with it in hand casts the seal on its active leaf (spellbook.lua). The same as spellbook.xml but for its look
	     and 'witch_book'. -->

	<VariableStorageComponent
		name="witch_book"
		value_string="quire"
	></VariableStorageComponent>

	<PhysicsBodyComponent
		_tags="enabled_in_world"
		uid="1"
		allow_sleep="1"
		angular_damping="0"
		fixed_rotation="0"
		is_bullet="1"
		linear_damping="0"
		auto_clean="1"
		hax_fix_going_through_ground="1"
		on_death_leave_physics_body="0"
		on_death_really_leave_body="0"
	></PhysicsBodyComponent>

	<!-- the emerald tablets' material: the book doesn't burn -->
	<PhysicsImageShapeComponent
		body_id="1"
		centered="1"
		image_file="mods/witch_notebook/files/gfx/palm_quire.png"
		material="rock_box2d_hard"
	></PhysicsImageShapeComponent>

	<ProjectileComponent
		_tags="enabled_in_world"
		lifetime="-1"
		penetrate_entities="1"
		never_hit_player="1"
	></ProjectileComponent>

	<VelocityComponent
		_tags="enabled_in_world"
	></VelocityComponent>

	<ItemComponent
		_tags="enabled_in_world"
		max_child_items="0"
		is_pickable="1"
		is_equipable_forced="1"
		always_use_item_name_in_ui="1"
		ui_sprite="mods/witch_notebook/files/gfx/palm_quire_icon.png"
		preferred_inventory="QUICK"
		item_name="Palm Quire"
		ui_description="A round notepad strapped to the hand: small seals only, but it casts quickly. Open it with RMB in hand or the key set in mod settings."
	></ItemComponent>

	<UIInfoComponent
		_tags="enabled_in_world"
		name="Palm Quire"
	></UIInfoComponent>

	<SpriteComponent
		_tags="enabled_in_hand"
		_enabled="0"
		offset_x="4"
		offset_y="7"
		image_file="mods/witch_notebook/files/gfx/palm_quire.png"
	></SpriteComponent>

	<HitboxComponent
		_tags="enabled_in_world"
		aabb_min_x="-4"
		aabb_max_x="4"
		aabb_min_y="-6"
		aabb_max_y="0"
	></HitboxComponent>

	<VariableStorageComponent
		name="witch_notebook_next_cast"
		value_int="0"
	></VariableStorageComponent>

	<LuaComponent
		_tags="enabled_in_hand"
		execute_every_n_frame="1"
		script_source_file="mods/witch_notebook/files/spellbook.lua"
	></LuaComponent>

	<LuaComponent
		script_item_picked_up="mods/witch_notebook/files/book_pickup.lua"
	></LuaComponent>

	<!-- Left click casts from the active page (spellbook.lua); the book is not throwable. -->
	<AbilityComponent
		ui_name="Palm Quire"
		throw_as_item="0"
		><gun_config
			deck_capacity="0"
		></gun_config>
	</AbilityComponent>
</Entity>
