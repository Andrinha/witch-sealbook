<Entity tags="witch_spellbook,item_pickup,item_physics,teleportable_NOT">
	<!-- The Great Tome (books.lua): big pages that hold the grandest seals, cast slowly. The first boss the witch
	     kills leaves one; the deeper Holy Mountains sell one, rarely. RMB in hand or the configured key opens it (notebook.lua), a left click with it in
	     hand casts the seal on its active page (spellbook.lua). The same as spellbook.xml but for its look and
	     'witch_book'. -->

	<VariableStorageComponent
		name="witch_book"
		value_string="tome"
	></VariableStorageComponent>

	<PhysicsBodyComponent
		_tags="enabled_in_world"
		uid="1"
		allow_sleep="1"
		angular_damping="0"
		fixed_rotation="0"
		is_bullet="1"
		linear_damping="0"
		auto_clean="1"
		hax_fix_going_through_ground="1"
		on_death_leave_physics_body="0"
		on_death_really_leave_body="0"
	></PhysicsBodyComponent>

	<!-- the emerald tablets' material: the book doesn't burn -->
	<PhysicsImageShapeComponent
		body_id="1"
		centered="1"
		image_file="mods/witch_notebook/files/gfx/great_tome.png"
		material="rock_box2d_hard"
	></PhysicsImageShapeComponent>

	<ProjectileComponent
		_tags="enabled_in_world"
		lifetime="-1"
		penetrate_entities="1"
		never_hit_player="1"
	></ProjectileComponent>

	<VelocityComponent
		_tags="enabled_in_world"
	></VelocityComponent>

	<ItemComponent
		_tags="enabled_in_world"
		max_child_items="0"
		is_pickable="1"
		is_equipable_forced="1"
		always_use_item_name_in_ui="1"
		ui_sprite="mods/witch_notebook/files/gfx/great_tome_icon.png"
		preferred_inventory="QUICK"
		item_name="Great Tome"
		ui_description="A copy from the Tower of Tomes: its pages hold the grandest seals. Heavy - it casts slowly. Open it with RMB in hand or the key set in mod settings."
	></ItemComponent>

	<UIInfoComponent
		_tags="enabled_in_world"
		name="Great Tome"
	></UIInfoComponent>

	<SpriteComponent
		_tags="enabled_in_hand"
		_enabled="0"
		offset_x="6"
		offset_y="7"
		image_file="mods/witch_notebook/files/gfx/great_tome.png"
	></SpriteComponent>

	<HitboxComponent
		_tags="enabled_in_world"
		aabb_min_x="-5"
		aabb_max_x="5"
		aabb_min_y="-7"
		aabb_max_y="0"
	></HitboxComponent>

	<VariableStorageComponent
		name="witch_notebook_next_cast"
		value_int="0"
	></VariableStorageComponent>

	<LuaComponent
		_tags="enabled_in_hand"
		execute_every_n_frame="1"
		script_source_file="mods/witch_notebook/files/spellbook.lua"
	></LuaComponent>

	<LuaComponent
		script_item_picked_up="mods/witch_notebook/files/book_pickup.lua"
	></LuaComponent>

	<!-- Left click casts from the active page (spellbook.lua); the book is not throwable. -->
	<AbilityComponent
		ui_name="Great Tome"
		throw_as_item="0"
		><gun_config
			deck_capacity="0"
		></gun_config>
	</AbilityComponent>
</Entity>
